# Copy to .env and fill in your own values, then deploy with `npm run deploy`.
# Never commit the real file.

# Telegram bot credentials.
# Create a bot with @BotFather and paste the token it gives you.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Your numeric chat id. Send the bot a message, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Alerting thresholds (USD and percent).
DAILY_THRESHOLD_USD=50
SPEND_CHANGE_THRESHOLD_PERCENT=30

# Optional: pin the stack to a specific account / region.
# When unset, the CDK CLI profile is used.
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1
